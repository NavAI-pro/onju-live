# Copy to `.env` and fill in.

# Gemini (used by both the live and conversational backends, plus the
# stall classifier in agentic mode).
GEMINI_API_KEY=

# Optional: OpenRouter / Anthropic for the conversational backend.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: ElevenLabs for the cloud TTS path.
# ELEVENLABS_API_KEY=

# Optional: agentic backend (OpenClaw).
# OPENCLAW_GATEWAY_TOKEN=
